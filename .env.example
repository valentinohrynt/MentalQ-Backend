DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=
# DB_DIALECT= example: mysql, postgres, sqlite, mariadb, mssql
DB_DIALECT=

PORT=
HOST=
NODE_ENV=

FRONTEND_URL=

EMAIL_USER=
EMAIL_PASSWORD=

TOKEN_SECRET=

MIDTRANS_SERVER_KEY=

# Cloudflare R2 S3-compatible API. Keep access keys server-side only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=media-mentalq
R2_PUBLIC_BASE_URL=https://media-mentalq.inoo.web.id

# Gemini journal analysis. Keep the API key server-side only.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_INPUT_CHARS=12000

# Paste the Firebase service-account JSON as a single-line JSON value.
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=https://mentalq-app-default-rtdb.firebaseio.com
